PIPEDRIVE_API_TOKEN=

# Strava MCP
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# JumpCloud MCP
JUMPCLOUD_API_KEY=

# Linear extra MCP
LINEAR_API_KEY=

