# Zeloo Agent 环境变量配置
# 复制为 .env 并填入实际值

# Zeloo 主目录
ZELOO_HOME=~/.Zeloo

# 默认模型与 Provider（默认为 OpenAI 兼容格式）
ZELOO_MODEL=gpt-4o
ZELOO_PROVIDER=openai

# LLM Provider API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=

# 可选 Provider（均为 OpenAI 兼容 API）
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
ZHIPU_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
REPLICATE_API_KEY=
HYPERBOLIC_API_KEY=
NOVITA_API_KEY=
LEPTON_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
DEEPINFRA_API_KEY=

# FAL.ai (视频/图片生成)
FAL_API_KEY=

# xAI Grok (聊天 + 图片 + 视频)
XAI_API_KEY=
HUGGINGFACE_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
CEREBRAS_API_KEY=
AI21_API_KEY=
LOCALAI_BASE_URL=http://localhost:8080/v1
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=
ANYSCALE_API_KEY=
FEATHERLESS_API_KEY=
MONSTERAPI_API_KEY=
DASHSCOPE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Azure OpenAI（企业部署）
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# Anthropic 注意：Anthropic 无原生 OpenAI 兼容端点，
# 需设置 ZELOO_BASE_URL 指向兼容代理（如 LiteLLM/OpenRouter），
# 或直接使用 openrouter provider 调用 Anthropic 模型。
ZELOO_BASE_URL=

# 自进化后台复盘（设为 true/1/yes 启用）
ZELOO_BG_REVIEW=false

# 成本阈值（USD，超过后 warn 记录日志，超过 abort 抛出异常）
ZELOO_COST_WARN_THRESHOLD=10.0
ZELOO_COST_ABORT_THRESHOLD=100.0

# Web 搜索（可选，按优先级使用：Tavily > Brave > DuckDuckGo）
SERPAPI_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SEARXNG_BASE_URL=https://search.example.com
FIRECRAWL_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
SERPER_API_KEY=
KAGI_API_KEY=
YOU_API_KEY=
PARALLEL_API_KEY=
KEENABLE_API_KEY=
SERPAPI_API_KEY=
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
SEARCH_360_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_NAME=
NCBI_API_KEY=
NCBI_EMAIL=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
BING_SEARCH_API_KEY=
X_BEARER_TOKEN=
RAINFOREST_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_BEARER_TOKEN=
GITHUB_TOKEN=

# 平台 Bot Token（网关模式）
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# PostgreSQL MCP
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

