FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
FRESHBOOKS_REFRESH_TOKEN=
FRESHBOOKS_ACCOUNT_ID=

# QuickBooks MCP
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=

# Plaid MCP
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Brex MCP
BREX_API_TOKEN=

# Ramp MCP
RAMP_API_KEY=

# Mercury MCP
MERCURY_API_TOKEN=

# n8n MCP
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# Make.com MCP
MAKE_API_KEY=
MAKE_ZONE=us1

# Zapier MCP
ZAPIER_API_KEY=

# Shortcut MCP
SHORTCUT_API_TOKEN=

# Aha! MCP
AHA_API_TOKEN=
AHA_DOMAIN=

# Productboard MCP
PRODUCTBOARD_API_TOKEN=

# Confluence MCP
CONFLUENCE_DOMAIN=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Coda MCP
CODA_API_TOKEN=

# Contentful MCP
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# Sanity MCP
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Mixpanel MCP
MIXPANEL_API_TOKEN=
MIXPANEL_PROJECT_ID=

# Amplitude MCP
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=

# Segment MCP
SEGMENT_WRITE_KEY=

# PostHog MCP
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://app.posthog.com

# Wrike MCP
WRIKE_API_TOKEN=

# Bitbucket MCP
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
BITBUCKET_WORKSPACE=

# Jenkins MCP
JENKINS_URL=http://localhost:8080
JENKINS_USER=
JENKINS_API_TOKEN=

# Octopus MCP
OCTOPUS_URL=
OCTOPUS_API_KEY=
OCTOPUS_SPACE_NAME=

# Bamboo MCP
BAMBOO_URL=
BAMBOO_USER=
BAMBOO_API_TOKEN=

# 后台复盘使用的模型（通常用便宜模型）
ZELOO_REVIEW_MODEL=gpt-4o-mini

# 多 Provider 故障转移（逗号分隔，按优先级排列）
# 例如：ZELOO_FALLBACK_PROVIDERS=deepseek,groq,openrouter
ZELOO_FALLBACK_PROVIDERS=

# 流式输出（设为 0/false/no 关闭，默认开启）
ZELOO_STREAM=true

# 终端工作目录（可选，不设置则使用当前目录）
TERMINAL_CWD=

# 终端后端选择（覆盖 config.yaml 的 terminal.backend）
# 可选: local, docker, ssh, modal, daytona, vercel_sandbox, singularity
TERMINAL_BACKEND=

# Docker 后端
DOCKER_IMAGE=python:3.12-slim

# SSH 后端
SSH_HOST=localhost
SSH_USER=root
SSH_PORT=22
SSH_KEY_FILE=

# Modal 后端（需安装 modal 包并配置 API Token）
MODAL_IMAGE=python:3.12-slim

# Daytona 后端
DAYTONA_API_URL=
DAYTONA_API_KEY=

# Vercel Sandbox 后端
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

# Singularity/Apptainer 后端
SINGULARITY_IMAGE=ubuntu:22.04

# 语音后端（覆盖 config.yaml 的 voice.backend）
# 可选: console, openai
ZELOO_VOICE_BACKEND=console

# 危险工具执行策略（shell / file_write / execute_code / delegate_task）
#   allow   (默认) — 直接执行
#   deny    — 拒绝执行并返回错误
#   confirm — 首次调用返回确认提示，需再次调用并传入 __confirm: true
ZELOO_DANGEROUS_POLICY=allow

# ============================================================================
# 离线模式
# ============================================================================
# 设为 1 时禁用所有网络调用（仅使用本地资源）
ZELOO_OFFLINE=0
