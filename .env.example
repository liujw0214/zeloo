ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# DigitalOcean MCP
DIGITALOCEAN_TOKEN=

# Upstash Redis MCP
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend MCP
RESEND_API_KEY=

# Kubernetes MCP
KUBECONFIG=
KUBECTL_CONTEXT=

# Shopify MCP
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=

# HubSpot MCP
HUBSPOT_ACCESS_TOKEN=

# Intercom MCP
INTERCOM_ACCESS_TOKEN=

