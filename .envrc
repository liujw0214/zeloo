#!/usr/bin/env bash
# direnv configuration for Zeloo development

# Activate uv virtualenv
layout python3.12

# Set development environment variables
export ZELOO_ENV="development"
export EDITOR="${EDITOR:-code}"

# Common aliases
alias t="zeloo"
alias ttest="python -m pytest tests/"
alias tlint="uv run ruff check ."

# Warn if .env is not set up
if [[ ! -f .env ]]; then
    echo "⚠️  No .env file found. Copy .env.example to .env and configure your API keys."
fi
