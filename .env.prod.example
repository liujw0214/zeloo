# Zeloo Agent — production environment overrides
# Copy to .env (next to docker-compose.prod.yml) and fill in real values.
# DO NOT commit .env to version control.

# ── Core ──────────────────────────────────────────────────────────────
zeloo_ENV=prod
zeloo_MODE=gateway
zeloo_MODEL=gpt-4o
zeloo_PROVIDER=openai

# ── API server auth ───────────────────────────────────────────────────
# Required in production. Generate via: openssl rand -hex 32
zeloo_API_TOKEN=replace-me-with-32-byte-hex

# ── Cost limits (USD) ─────────────────────────────────────────────────
zeloo_COST_WARN_THRESHOLD=10
zeloo_COST_ABORT_THRESHOLD=100

# ── Background self-evolution ────────────────────────────────────────
zeloo_BG_REVIEW=true
zeloo_STREAM=true

# ── Dangerous tool policy: allow | deny | confirm ─────────────────────
zeloo_DANGEROUS_POLICY=confirm

# ── Provider fallback chain (comma-separated) ─────────────────────────
zeloo_FALLBACK_PROVIDERS=deepseek,groq,openrouter

# ── Cron schedule (used by zeloo-cron container) ──────────────────────
ZELOO_CRON_SCHEDULE=0 */1 * * *
ZELOO_BACKUP_SCHEDULE=0 3 * * *
ZELOO_BACKUP_KEEP_DAYS=30

# ── LLM Provider API keys (fill in at least one) ─────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Messaging platform tokens ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# ── Off-host backup configuration ─────────────────────────────────────
# Options: local | s3 | oss | null
OFFHOST_BACKEND=local
OFFHOST_LOCAL_DIR=/var/lib/Zeloo-offhost

# For OFFHOST_BACKEND=s3:
OFFHOST_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# For OFFHOST_BACKEND=oss (Aliyun):
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ── Caddy reverse proxy (if --profile caddy) ────────────────────────
CADDY_DOMAIN=zeloo.example.com