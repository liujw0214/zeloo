#!/bin/sh
# Zeloo launcher wrapper (Debian package layout).
#
# Resolves the bundled virtualenv, then forwards every argument to the
# `zeloo_cli` module. This indirection lets the systemd unit, the user
# CLI, and ad-hoc debugging all share a single source of truth for the
# runtime interpreter.
#
# The wrapper:
#   1. Picks the bundled venv interpreter when available, falling back
#      to the system `python3` so partial upgrades still work.
#   2. Exports ZELOO_HOME so the runtime finds /var/lib/zeloo by default,
#      while still respecting operator overrides from the environment.
#   3. Surfaces actionable error messages when the venv is missing or the
#      interpreter cannot be located.
#   4. Forwards exit codes faithfully (no swallowing via `exec` only).

set -e

ZELOO_VENV="/opt/zeloo/venv"
ZELOO_HOME_DEFAULT="/var/lib/zeloo"

if [ -z "${ZELOO_HOME:-}" ]; then
    export ZELOO_HOME="$ZELOO_HOME_DEFAULT"
fi

if [ ! -x "$ZELOO_VENV/bin/python" ]; then
    echo "zeloo: bundled virtualenv missing at $ZELOO_VENV" >&2
    echo "zeloo: please reinstall the zeloo package." >&2
    exit 1
fi

# Pick the right interpreter: the venv one if available, otherwise system
# python3 (lets the wrapper degrade gracefully during partial upgrades).
if [ -x "$ZELOO_VENV/bin/python" ]; then
    exec "$ZELOO_VENV/bin/python" -m zeloo_cli "$@"
fi

exec python3 -m zeloo_cli "$@"
