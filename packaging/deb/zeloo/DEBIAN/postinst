#!/bin/sh
# postinst script for zeloo
set -e

ZELOO_USER="zeloo"
ZELOO_HOME="/var/lib/zeloo"
ZELOO_VENV="/opt/zeloo/venv"
ZELOO_BIN="/usr/bin/zeloo"
ZELOO_SYSTEMD="/etc/systemd/system/zeloo.service"

case "$1" in
    configure)
        # 1. Create the dedicated system user (Debian-policy friendly: no login,
        #    no home creation beyond /var/lib/zeloo).
        if ! id "$ZELOO_USER" >/dev/null 2>&1; then
            adduser --system --no-create-home --group --home "$ZELOO_HOME" "$ZELOO_USER"
        fi

        # 2. Bootstrap the workspace directory tree.
        mkdir -p "$ZELOO_HOME"/{workspace,archive,profile,memory,skills,logs}
        chown -R "$ZELOO_USER":"$ZELOO_USER" "$ZELOO_HOME"
        chmod 0750 "$ZELOO_HOME"

        # 3. Ensure the bundled Python virtualenv is reachable.
        if [ -x "$ZELOO_VENV/bin/python" ]; then
            "$ZELOO_VENV/bin/pip" install --no-cache-dir --quiet --upgrade pip || true
        fi

        # 4. Install the systemd unit (if a unit file ships with the package).
        if [ -f "$ZELOO_SYSTEMD" ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            if [ -d /run/systemd/system ]; then
                systemctl enable zeloo.service >/dev/null 2>&1 || true
            fi
        fi

        # 5. Final user-facing hint.
        echo "Zeloo has been installed."
        echo "Run 'sudo -u $ZELOO_USER $ZELOO_BIN doctor' to verify the install."
        echo "Run 'sudo -u $ZELOO_USER $ZELOO_BIN install' for first-run setup."
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        # Nothing to undo on partial transitions; dpkg handles it.
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
