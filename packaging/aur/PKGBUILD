# Maintainer: Zeloo Team <team@zeloo.io>
pkgname=zeloo
pkgver=0.1.0
pkgrel=1
pkgdesc="Self-hosted, self-evolving resident AI Agent runtime"
arch=('any')
url="https://github.com/your-org/Zeloo"
license=('Apache-2.0')
depends=('python>=3.11')
makedepends=('python-pip' 'python-virtualenv' 'rust' 'cargo' 'git')
optdepends=(
    'playwright: browser automation plugin'
    'mcp: model-context-protocol bridge'
    'sounddevice: voice gateway'
)
provides=('zeloo')
conflicts=('zeloo-git')
source=("https://github.com/your-org/Zeloo/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('PLACEHOLDER_TARBALL_SHA256')

prepare() {
  cd "${srcdir}/Zeloo-${pkgver}"
  # Allow the source tree to be consumed from the unpacked tarball name.
  cp -r . "${srcdir}/${pkgname}-${pkgver}"
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # Build the native Rust extension (FTS5 CJK tokenizer) on demand.
  if [ -d native/fts5_cjk ]; then
      (cd native/fts5_cjk && cargo build --release)
  fi

  # Materialise the runtime virtualenv we will package.
  python -m venv "${srcdir}/venv"
  source "${srcdir}/venv/bin/activate"
  pip install --no-cache-dir --quiet --upgrade pip
  pip install --no-cache-dir --quiet .
  deactivate
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # Install the prebuilt virtualenv under /opt/zeloo.
  install -dm755 "${pkgdir}/opt/zeloo"
  cp -a "${srcdir}/venv" "${pkgdir}/opt/zeloo/"

  # CLI wrapper that points at the bundled venv.
  install -dm755 "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/zeloo" <<'EOF'
#!/usr/bin/env bash
set -e
export ZELOO_HOME="${ZELOO_HOME:-/var/lib/zeloo}"
exec /opt/zeloo/venv/bin/python -m zeloo_cli "$@"
EOF
  chmod 0755 "${pkgdir}/usr/bin/zeloo"

  # Optional: install a default profile template under /etc/zeloo.
  install -dm755 "${pkgdir}/etc/zeloo"
  if [ -f config.yaml.example ]; then
      install -m0644 config.yaml.example "${pkgdir}/etc/zeloo/config.yaml"
  fi

  # Install license + docs.
  install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
  install -m0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" || true

  install -dm755 "${pkgdir}/usr/share/doc/${pkgname}"
  install -m0644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md" || true
}

# vim:set ts=2 sw=2 et:
