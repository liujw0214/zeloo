[Unit]
Description=Zeloo Agent Runtime
Documentation=https://docs.zeloo.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zeloo gateway foreground
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
User=zeloo
Group=zeloo

# 环境变量
Environment=ZELOO_HOME=/var/lib/Zeloo
EnvironmentFile=-/etc/Zeloo/Zeloo.env

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/Zeloo /var/log/Zeloo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true

# 资源限制
LimitNOFILE=65536
MemoryMax=2G

[Install]
WantedBy=multi-user.target